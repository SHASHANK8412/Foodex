# Settings for `docker compose` (copy to .env; .env is git-ignored).

# Required. Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
GRAPHQL_PERSISTED_SECRET=

# Demo accounts, restaurants and coupons are created on first start.
SEED_DEMO_DATA=true

# Set to true together with `--profile data` to route events through Kafka.
KAFKA_ENABLED=false

# Optional. Without Razorpay keys, checkout uses mock payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_GEMINI_API_KEY=
# AI ordering agent: a Groq or Gemini key enables the LLM planner.
GROQ_API_KEY=
AGENT_LLM_PROVIDER=auto
